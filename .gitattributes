# Einheitliche Zeilenenden
* text=auto

*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.example text eol=lf

# DayZ/Windows-Konfigurationen werden unter Windows genutzt
*.cfg text eol=crlf
*.ini text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binärdateien niemals als Text behandeln
*.zip binary
*.7z binary
*.rar binary
*.png binary
*.jpg binary
*.jpeg binary
*.pbo binary
*.bisign binary
*.bikey binary
