{
  "name": "deutschz-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "DeutschZ Discord community and DayZ status bot",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "register": "tsx src/register-commands.ts",
    "migrate": "tsx src/migrate.ts",
    "preflight:whatsapp": "tsx src/preflight-whatsapp.ts",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "fast-xml-parser": "^5.10.1",
    "gamedig": "^5.3.2",
    "luxon": "^3.7.1",
    "pino": "^9.7.0",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.17.0",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.32.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
